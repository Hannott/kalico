# Tests for corexy precise homing
CONFIG corexy_precise_homing.cfg
DICTIONARY atmega2560.dict

; Home with the origin learned from the first homing
G28
G90
G1 F6000
G1 X100 Y100

; Store a calibrated origin, then home against it
COREXY_PRECISE_HOMING_CALIBRATE SAMPLES=2
G28 X Y
G1 X50 Y50
G28
G1 X0 Y0 Z1
